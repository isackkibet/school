generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum FeeFrequency { ON_ADMISSION PER_TERM PER_SEMESTER FINAL_TERM ON_EXAM_BOOKING ON_ATTACHMENT OPTIONAL ONCE }
enum ResourceType { PDF_NOTE PAST_PAPER MARKING_SCHEME VIDEO_LESSON SIMULATION PRACTICAL_GUIDE BOOK AI_TUTOR_PROMPT }

model School { id String @id @default(uuid()) name String slug String @unique description String? isActive Boolean @default(true) courses Course[] createdAt DateTime @default(now()) }
model ExamBody { id String @id @default(uuid()) name String code String @unique country String @default("Kenya") isExternal Boolean @default(true) offerings CourseOffering[] rules AdmissionRule[] progressions AcademicProgressionPath[] }
model Course { id String @id @default(uuid()) schoolId String school School @relation(fields:[schoolId], references:[id]) name String slug String @unique description String? careerSummary String? employmentScore Decimal @default(0) isActive Boolean @default(true) offerings CourseOffering[] resources LibraryResource[] createdAt DateTime @default(now()) }
model CourseOffering { id String @id @default(uuid()) courseId String course Course @relation(fields:[courseId], references:[id]) examBodyId String examBody ExamBody @relation(fields:[examBodyId], references:[id]) level String durationMonths Int numberOfTerms Int tuitionFeePerTerm Decimal practicalFeePerTerm Decimal @default(0) minimumGrade String? entryRequirement String? intakeFrequency String @default("Monthly") isShortCourse Boolean @default(false) isActive Boolean @default(true) feeOverrides CourseFeeOverride[] toolRequirements CoursePracticalRequirement[] lecturerTemplate LecturerCourseTemplate? resources LibraryResource[] }
model AdmissionRule { id String @id @default(uuid()) examBodyId String examBody ExamBody @relation(fields:[examBodyId], references:[id]) level String minimumGrade String mandatorySubjects Json? alternativeQualification String? progressionFrom String? notes String? }
model FeeComponent { id String @id @default(uuid()) name String amount Decimal frequency FeeFrequency appliesTo String isMandatory Boolean @default(true) overrides CourseFeeOverride[] }
model CourseFeeOverride { id String @id @default(uuid()) courseOfferingId String courseOffering CourseOffering @relation(fields:[courseOfferingId], references:[id]) feeComponentId String feeComponent FeeComponent @relation(fields:[feeComponentId], references:[id]) amount Decimal? frequency FeeFrequency? notes String? }
model PracticalToolCategory { id String @id @default(uuid()) name String tools PracticalTool[] }
model PracticalTool { id String @id @default(uuid()) categoryId String category PracticalToolCategory @relation(fields:[categoryId], references:[id]) name String description String? estimatedPrice Decimal? isRequired Boolean @default(true) requirements CoursePracticalRequirement[] }
model CoursePracticalRequirement { id String @id @default(uuid()) courseOfferingId String courseOffering CourseOffering @relation(fields:[courseOfferingId], references:[id]) practicalToolId String practicalTool PracticalTool @relation(fields:[practicalToolId], references:[id]) quantity Int @default(1) requirementStage String @default("Before Practical Lessons") notes String? }
model AcademicProgressionPath { id String @id @default(uuid()) examBodyId String examBody ExamBody @relation(fields:[examBodyId], references:[id]) currentLevel String nextLevel String minimumRequirement String? notes String? }
model LibraryResource { id String @id @default(uuid()) title String resourceType ResourceType url String? filePath String? courseId String? course Course? @relation(fields:[courseId], references:[id]) courseOfferingId String? courseOffering CourseOffering? @relation(fields:[courseOfferingId], references:[id]) level String? unitName String? isRequired Boolean @default(false) createdAt DateTime @default(now()) }
model LecturerCourseTemplate { id String @id @default(uuid()) courseOfferingId String @unique courseOffering CourseOffering @relation(fields:[courseOfferingId], references:[id]) defaultLessonsPerTerm Int @default(12) defaultCatsPerTerm Int @default(2) defaultPracticalsPerTerm Int @default(4) attendanceRequirementPercent Int @default(80) assessmentModel Json? createdAt DateTime @default(now()) }
model StudentCourseMatch { id String @id @default(uuid()) studentId String? kcseGrade String interests Json? budget Decimal? preferredMode String? recommendedCourses Json createdAt DateTime @default(now()) }
